# Copy this file to .env and fill in real values. Never commit .env itself.

# Gemini API key from https://aistudio.google.com (Get API key)
GOOGLE_API_KEY=your-gemini-api-key-here

# Gemini model to use for tutoring/correction calls
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated origins allowed to call this API (loosen for local dev, lock down for prod)
CORS_ORIGINS=*
