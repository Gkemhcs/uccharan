<?xml version="1.0" encoding="utf-8"?>
<!--
    Uccharan's launcher icon background — the app's own teal brand gradient
    (matches UccharanGradients.primaryButton in Gradients.kt), not the stock
    Android Studio template gradient this replaced. Vector-drawn, no raster
    asset — same "no image assets" approach used for the in-app tutor
    character (see TutorCharacter.kt).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#1B7D7A" android:offset="0.0" />
                <item android:color="#146C6B" android:offset="0.5" />
                <item android:color="#0E4B49" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
